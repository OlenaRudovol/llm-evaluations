# Environment variables for LLM evaluation
# Copy this file to .env and fill in your values

# LLM provider to use: 'ollama' (default), 'openai', 'anthropic', or 'google'
LLM_PROVIDER=ollama

# Anthropic API key (required for Anthropic evaluation)
ANTHROPIC_API_KEY=sk-your-anthropic-api-key-here

# Anthropic model to use (optional, defaults to claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI API key (required for OpenAI evaluation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google API key (required for Google evaluation, get free at aistudio.google.com)
GOOGLE_API_KEY=your-google-api-key-here

# Google model to use (optional, defaults to gemini-2.0-flash)
GOOGLE_MODEL=gemini-2.0-flash

# Ollama model to use (optional, defaults to gemma3:1b)
OLLAMA_MODEL=gemma3:1b

# Ollama server host (optional, defaults to localhost)
OLLAMA_HOST=localhost

# Ollama server port (optional, defaults to 11434)
OLLAMA_PORT=11434