# Environment variables for LLM evaluation
# Copy this file to .env and fill in your values

# LLM provider to use: 'ollama' (default), 'openai', or 'groq'
LLM_PROVIDER=ollama

# OpenAI API key (required for OpenAI evaluation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Groq API key (required for Groq evaluation, free tier at console.groq.com)
GROQ_API_KEY=gsk-your-groq-api-key-here

# Groq model to use (optional, defaults to llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Ollama model to use (optional, defaults to gemma3:1b)
OLLAMA_MODEL=gemma3:1b

# Additionally run LLM-as-judge evaluation alongside substring matching (optional, defaults to false)
USE_LLM_JUDGE=false

# Model to use as the judge, same provider as LLM_PROVIDER (optional; unset means
# the judge is the same model being tested — a weak/fast model can be an unreliable
# judge of its own answers, so a stronger model here often gives better verdicts)
JUDGE_MODEL=